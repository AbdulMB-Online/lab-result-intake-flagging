# Copy to .env and fill in. The .env file is ignored by git; never commit it.
# These are only read when --email-to is given.
LAB_SMTP_HOST=smtp.example.org
LAB_SMTP_PORT=587
LAB_SMTP_USER=
LAB_SMTP_PASSWORD=
# Set to 0 for a local test server such as Mailpit, which has no TLS.
LAB_SMTP_STARTTLS=1
LAB_MAIL_FROM=lab-intake@example.org
